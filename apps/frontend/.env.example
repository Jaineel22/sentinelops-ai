# SentinelOps frontend (Phase 10 / 10.1). Copy to .env.local for local dev.
# These are the server-side proxy targets used by next.config.mjs rewrites —
# the browser only ever talks to the Next server at same-origin /api/*.

# Local dev (services run on the host via `make run-correlator` etc. or compose):
INCIDENT_API_URL=http://localhost:8002
RCA_API_URL=http://localhost:8004
REMEDIATION_API_URL=http://localhost:8005
DETECTOR_API_URL=http://localhost:8003
# apps/api (Phase 10.1 auth: /api/v1/auth/{login,me,register}). Run it with
# `make run` or `docker compose up api`.
AUTH_API_URL=http://localhost:8000

# In docker-compose the frontend container uses the internal service names:
# INCIDENT_API_URL=http://incident-correlator:8000
# RCA_API_URL=http://rca-agent:8000
# REMEDIATION_API_URL=http://remediation-controller:8000
# DETECTOR_API_URL=http://anomaly-detector:8000
# AUTH_API_URL=http://api:8000
