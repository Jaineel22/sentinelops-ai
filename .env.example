# Copy to `.env` and adjust for your machine. `.env` is git-ignored.
# Every variable is read via sentinelops_api.config.Settings (prefix: APP_).

# Deployment environment: development | test | staging | production
APP_ENV=development

# Host/port the API binds to when run locally or in a container.
APP_HOST=0.0.0.0
APP_PORT=8000

# Uvicorn log level: critical | error | warning | info | debug | trace
APP_LOG_LEVEL=info

# --- Reserved for later phases (do NOT set yet) -----------------------------
# PostgreSQL, Redis, Kafka, MLflow, and LLM API settings are added in the
# phase that introduces each subsystem. Keeping them out now avoids implying
# infrastructure that does not exist.
