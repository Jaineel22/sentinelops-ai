# Copy to `.env` and adjust for your machine. `.env` is git-ignored.
# Settings are read via typed pydantic-settings objects, never os.environ.

# ─── Process / runtime (APP_) ──────────────────────────────────────────────
# Environment: development | test | staging | production
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# ─── Kafka event backbone (KAFKA_) — Phase 1 + 3 ──────────────────────────
# From the host (local runs, traffic generator, integration tests): localhost:29092
# From inside docker compose: kafka:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_ORDERS_TOPIC=orders.events
# Dev convenience: services create their topics on startup if missing.
KAFKA_AUTO_CREATE_TOPIC=true
KAFKA_AUTO_CREATE_TOPICS=true
# Phase 3 topics. Partition key = the correlation service name (ADR-018);
# ordering is per-partition only — never assume global order.
KAFKA_ANOMALY_TOPIC=anomaly.events
KAFKA_ANOMALY_DLQ_TOPIC=anomaly.events.dlq
KAFKA_INCIDENT_TOPIC=incident.events
KAFKA_CONSUMER_GROUP=incident-correlator
# At-least-once consume: a handler failure is retried this many times, then the
# message is dead-lettered (ADR-016).
KAFKA_MAX_RETRIES=3
KAFKA_RETRY_BACKOFF_SECONDS=2.0

# ─── Incident state store (DB_) — Phase 3, PostgreSQL (ADR-014) ────────────
# Dev/test credentials only — the compose file uses the same throwaway pair.
# From the host: localhost:5432   From inside docker compose: postgres:5432
DB_URL=postgresql+asyncpg://sentinelops:sentinelops@localhost:5432/sentinelops
DB_ECHO=false
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=5

# ─── Deterministic correlation (CORRELATION_) — Phase 3 (ADR-015) ──────────
# Anomalies for one service within this window fold into the same incident;
# a later anomaly after the window supersedes the stale incident with a new one.
# 300s = 30 telemetry windows at the 10s scrape cadence — long enough to bridge
# a brief recovery dip, short enough that unrelated later faults start fresh.
CORRELATION_WINDOW_SECONDS=300

# ─── Deterministic severity rules (SEVERITY_) — Phase 3 ───────────────────
# Highest firing rule wins; every firing reason is recorded on the incident.
# Defaults are sane — override only to retune. See docs/architecture/incident-model.md.
# SEVERITY_ANOMALY_COUNT_MEDIUM=3
# SEVERITY_DISTINCT_SIGNALS_MEDIUM=2
# SEVERITY_ERROR_RATE_HIGH=0.10
# SEVERITY_LATENCY_P95_HIGH_MS=500
# SEVERITY_DURATION_HIGH_SECONDS=120
# SEVERITY_ERROR_RATE_CRITICAL=0.30
# SEVERITY_DURATION_CRITICAL_SECONDS=300

# ─── Streaming anomaly detector (DETECTOR_) — Phase 3 ─────────────────────
# From the host: http://localhost:8001/metrics   compose: http://orders-service:8000/metrics
DETECTOR_TARGET_METRICS_URL=http://localhost:8001/metrics
DETECTOR_TARGET_SERVICE=orders-service
DETECTOR_ENVIRONMENT=development
DETECTOR_POLL_INTERVAL_SECONDS=10
# Trained once at first start from the committed run_a telemetry (fixed seed),
# then cached here. Delete the file to retrain.
DETECTOR_MODEL_PATH=artifacts/models/detector_stream.joblib
DETECTOR_SEED=42

# ─── OpenTelemetry observability pipeline (OTEL_) — Phase 1 ────────────────
OTEL_SERVICE_NAME=orders-service
# No collector is deployed in Phase 1 (that is Phase 7). Leave unset to only
# *generate* traces; set to e.g. http://localhost:4318 to export via OTLP/HTTP.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# Print spans to stdout for local inspection without a collector.
OTEL_TRACES_CONSOLE_EXPORT=false
# Metrics are always exposed for Prometheus to scrape at this path.
OTEL_METRICS_PATH=/metrics

# ─── Failure injection (ORDERS_) — development only, disabled by default ────
# Refused at startup when APP_ENV=production (ADR-009).
ORDERS_SIMULATE_LATENCY_MS=0
ORDERS_SIMULATE_ERROR_RATE=0.0
ORDERS_SIMULATE_PUBLISH_ERROR_RATE=0.0
# Mounts the dev-only PUT/GET /admin/simulation endpoint. Forced off in production.
ORDERS_SIM_ADMIN_ENABLED=true

# ─── Reserved for later phases (do NOT set yet) ────────────────────────────
# PostgreSQL, Redis, MLflow, and LLM API settings arrive with the phases that
# introduce those subsystems.
