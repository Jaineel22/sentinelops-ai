# Copy to `.env` and adjust for your machine. `.env` is git-ignored.
# Settings are read via typed pydantic-settings objects, never os.environ.

# ─── Process / runtime (APP_) ──────────────────────────────────────────────
# Environment: development | test | staging | production
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# ─── Kafka event backbone (KAFKA_) — Phase 1 + 3 ──────────────────────────
# From the host (local runs, traffic generator, integration tests): localhost:29092
# From inside docker compose: kafka:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_ORDERS_TOPIC=orders.events
# Dev convenience: services create their topics on startup if missing.
KAFKA_AUTO_CREATE_TOPIC=true
KAFKA_AUTO_CREATE_TOPICS=true
# Phase 3 topics. Partition key = the correlation service name (ADR-018);
# ordering is per-partition only — never assume global order.
KAFKA_ANOMALY_TOPIC=anomaly.events
KAFKA_ANOMALY_DLQ_TOPIC=anomaly.events.dlq
KAFKA_INCIDENT_TOPIC=incident.events
# Phase 4: the rca-agent consumes incident.opened from KAFKA_INCIDENT_TOPIC and
# dead-letters malformed events here.
KAFKA_INCIDENT_DLQ_TOPIC=incident.events.dlq
# Phase 5G: the remediation-controller PUBLISHES lifecycle events here (key =
# remediation_id) after each committed transition; it consumes no topic (ADR-030).
# KAFKA_ENABLED=false degrades to audit-trail-only.
KAFKA_REMEDIATION_TOPIC=remediation.events
# One consumer group per service. compose + the `run-*` make targets set this
# per service; if you set it here it applies to whichever service you run.
KAFKA_CONSUMER_GROUP=incident-correlator
# At-least-once consume: a handler failure is retried this many times, then the
# message is dead-lettered (ADR-016).
KAFKA_MAX_RETRIES=3
KAFKA_RETRY_BACKOFF_SECONDS=2.0

# ─── Incident state store (DB_) — Phase 3, PostgreSQL (ADR-014) ────────────
# Dev/test credentials only — the compose file uses the same throwaway pair.
# From the host: localhost:5432   From inside docker compose: postgres:5432
DB_URL=postgresql+asyncpg://sentinelops:sentinelops@localhost:5432/sentinelops
DB_ECHO=false
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=5

# ─── Deterministic correlation (CORRELATION_) — Phase 3 (ADR-015) ──────────
# Anomalies for one service within this window fold into the same incident;
# a later anomaly after the window supersedes the stale incident with a new one.
# 300s = 30 telemetry windows at the 10s scrape cadence — long enough to bridge
# a brief recovery dip, short enough that unrelated later faults start fresh.
CORRELATION_WINDOW_SECONDS=300

# ─── Deterministic severity rules (SEVERITY_) — Phase 3 ───────────────────
# Highest firing rule wins; every firing reason is recorded on the incident.
# Defaults are sane — override only to retune. See docs/architecture/incident-model.md.
# SEVERITY_ANOMALY_COUNT_MEDIUM=3
# SEVERITY_DISTINCT_SIGNALS_MEDIUM=2
# SEVERITY_ERROR_RATE_HIGH=0.10
# SEVERITY_LATENCY_P95_HIGH_MS=500
# SEVERITY_DURATION_HIGH_SECONDS=120
# SEVERITY_ERROR_RATE_CRITICAL=0.30
# SEVERITY_DURATION_CRITICAL_SECONDS=300

# ─── Streaming anomaly detector (DETECTOR_) — Phase 3 ─────────────────────
# From the host: http://localhost:8001/metrics   compose: http://orders-service:8000/metrics
DETECTOR_TARGET_METRICS_URL=http://localhost:8001/metrics
DETECTOR_TARGET_SERVICE=orders-service
DETECTOR_ENVIRONMENT=development
DETECTOR_POLL_INTERVAL_SECONDS=10
# Trained once at first start from the committed run_a telemetry (fixed seed),
# then cached here. Delete the file to retrain.
DETECTOR_MODEL_PATH=artifacts/models/detector_stream.joblib
DETECTOR_SEED=42

# ─── Detector health thresholds (HEALTH_) — Phase 7C ──────────────────────
# These only flip /ready's soft `healthy` flag (+ `health_reasons`); they never
# change the /ready HTTP status, which stays tied to the scoring loop being alive.
HEALTH_UNHEALTHY_AFTER_NO_INFERENCE_SECONDS=300
HEALTH_UNHEALTHY_IF_ANOMALY_RATE_ABOVE=50.0
HEALTH_UNHEALTHY_IF_AVG_LATENCY_ABOVE_MS=5000.0

# ─── OpenTelemetry observability pipeline (OTEL_) — Phase 1 ────────────────
OTEL_SERVICE_NAME=orders-service
# No collector is deployed in Phase 1 (that is Phase 7). Leave unset to only
# *generate* traces; set to e.g. http://localhost:4318 to export via OTLP/HTTP.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# Print spans to stdout for local inspection without a collector.
OTEL_TRACES_CONSOLE_EXPORT=false
# Metrics are always exposed for Prometheus to scrape at this path.
OTEL_METRICS_PATH=/metrics

# ─── Failure injection (ORDERS_) — development only, disabled by default ────
# Refused at startup when APP_ENV=production (ADR-009).
ORDERS_SIMULATE_LATENCY_MS=0
ORDERS_SIMULATE_ERROR_RATE=0.0
ORDERS_SIMULATE_PUBLISH_ERROR_RATE=0.0
# Mounts the dev-only PUT/GET /admin/simulation endpoint. Forced off in production.
ORDERS_SIM_ADMIN_ENABLED=true

# ─── AI RCA / investigation agent (RCA_ / LLM_) — Phase 4 (ADR-019/021/022) ─
# mock  = deterministic, network-free reasoner; no API key; the CI default.
# live  = call a real LLM provider behind the same LlmClient protocol.
RCA_MODE=mock
RCA_INCIDENT_API_BASE_URL=http://localhost:8002
# Investigation bounds — deterministic code owns these; the LLM never sees them.
RCA_MAX_TOOL_CALLS=12
RCA_MAX_INVESTIGATION_STEPS=25
RCA_MAX_EVIDENCE_ITEMS=40
RCA_INVESTIGATION_TIMEOUT_SECONDS=120
RCA_MAX_HYPOTHESES=5

# Live-mode LLM provider. Only read when RCA_MODE=live.
LLM_PROVIDER=anthropic
# Unset -> the provider client's pinned default model.
# LLM_MODEL=claude-opus-5
# Secret — set only in your git-ignored .env, never here. Placeholder only:
# LLM_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_MAX_OUTPUT_TOKENS=4096
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_PROMPT_CHARS=200000

# ─── Phase 6: MLOps lifecycle (MLFLOW_) — COMPLETE ────────────────────────
# MLflow experiment tracking + model registry (aliases, not stages), PSI drift
# detection, and a `python -m ml.mlops retrain` workflow. All optional: with
# MLFLOW_TRACKING_URI empty the ML pipeline and the anomaly-detector behave
# exactly as in Phases 2-5.
# Local only: `docker/mlflow/Dockerfile` + the `mlflow` Compose service. UI/API
# at http://localhost:5000. A sqlite/file URI works offline and for tests but
# cannot hold the model registry (aliases need a DB-backed store).
#
# **Leave MLFLOW_TRACKING_URI empty to run Phases 2–5 exactly as before** — the
# anomaly-detector then loads its local bundle and never contacts MLflow.
# Set it to opt in:
#   host tools (`python -m ml.experiments`, `python -m ml.mlops`) → http://localhost:5000
#   the anomaly-detector container (Phase 6C)                      → http://mlflow:5000
#     (docker-compose passes MLFLOW_TRACKING_URI through as-is, so use the
#      in-network URL when running the detector under compose)
MLFLOW_TRACKING_URI=
MLFLOW_REGISTERED_MODEL_NAME=sentinelops-anomaly-detector
# Alias the inference path resolves (Phase 6C): champion | candidate
MLFLOW_MODEL_ALIAS=champion
# true  -> a component that needs MLflow fails loudly if it is unreachable
#          (the anomaly-detector's /ready then reports 503)
# false -> it falls back to the local bundle explicitly (logged, never silent).
MLFLOW_REQUIRED=false
MLFLOW_EXPERIMENT_NAME=sentinelops-anomaly-detection
# The mlflow *server* container connects to a dedicated database on the existing
# Postgres: postgresql://sentinelops:sentinelops@postgres:5432/mlflow (created by
# the one-shot `mlflow-init` service). That is not a host setting.

# ─── Reserved for later phases (do NOT set yet) ────────────────────────────
# Redis settings arrive with the phase that needs it. Observability-stack
# endpoints (Prometheus / Loki / Tempo / Grafana) arrive in Phase 7.
