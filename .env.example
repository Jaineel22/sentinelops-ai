# Copy to `.env` and adjust for your machine. `.env` is git-ignored.
# Settings are read via typed pydantic-settings objects, never os.environ.

# ─── Process / runtime (APP_) ──────────────────────────────────────────────
# Environment: development | test | staging | production
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

# ─── Kafka event backbone (KAFKA_) — Phase 1 ───────────────────────────────
# From the host (local runs, traffic generator, integration tests): localhost:29092
# From inside docker compose: kafka:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_ORDERS_TOPIC=orders.events
# Dev convenience: orders-service creates the topic on startup if missing.
KAFKA_AUTO_CREATE_TOPIC=true

# ─── OpenTelemetry observability pipeline (OTEL_) — Phase 1 ────────────────
OTEL_SERVICE_NAME=orders-service
# No collector is deployed in Phase 1 (that is Phase 7). Leave unset to only
# *generate* traces; set to e.g. http://localhost:4318 to export via OTLP/HTTP.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# Print spans to stdout for local inspection without a collector.
OTEL_TRACES_CONSOLE_EXPORT=false
# Metrics are always exposed for Prometheus to scrape at this path.
OTEL_METRICS_PATH=/metrics

# ─── Failure injection (ORDERS_) — development only, disabled by default ────
# Refused at startup when APP_ENV=production (ADR-009).
ORDERS_SIMULATE_LATENCY_MS=0
ORDERS_SIMULATE_ERROR_RATE=0.0
ORDERS_SIMULATE_PUBLISH_ERROR_RATE=0.0
# Mounts the dev-only PUT/GET /admin/simulation endpoint. Forced off in production.
ORDERS_SIM_ADMIN_ENABLED=true

# ─── Reserved for later phases (do NOT set yet) ────────────────────────────
# PostgreSQL, Redis, MLflow, and LLM API settings arrive with the phases that
# introduce those subsystems.
